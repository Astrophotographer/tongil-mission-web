{
  "name": "통일탐방 미니 → Google Sheets",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tongil-mission-save",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-tongil",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "webhookId": "tongil-mission-save"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst b = (raw.body && typeof raw.body === 'object') ? raw.body : raw;\nreturn [{\n  json: {\n    recorded_at_kr: b.recorded_at_kr || '',\n    kind_label: b.kind_label || '',\n    kind: b.kind || '',\n    input: String(b.input || ''),\n    summary: String(b.summary || ''),\n    source: b.source || 'tongil-mission-web',\n  }\n}];"
      },
      "id": "flatten",
      "name": "Flatten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/1rDj4q5y8z5rS1UO6TH7huiSfVWcW-JTFMmA3fC82D9Q/values/%EA%B8%B0%EB%A1%9D!A:F:append?valueInputOption=USER_ENTERED&insertDataOption=INSERT_ROWS",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ values: [[$json.recorded_at_kr, $json.kind_label, $json.kind, $json.input, $json.summary, $json.source]] }) }}",
        "options": {}
      },
      "id": "http-sheets-append",
      "name": "Sheets Append HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "pW6CTqVeBi6zwwqL",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Flatten",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Flatten": {
      "main": [
        [
          {
            "node": "Sheets Append HTTP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  }
}
